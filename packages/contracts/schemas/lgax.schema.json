{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lgax.local/contracts/0.1.0/lgax.schema.json",
  "title": "LG AX shared contracts 0.1.0",
  "description": "Future analysis types define interfaces only. Bootstrap implements synthetic read-only evidence retrieval.",
  "x-contract-version": "0.1.0",
  "$defs": {
    "SourceKind": {
      "enum": [
        "synthetic",
        "public",
        "licensed",
        "private"
      ]
    },
    "ProductGroup": {
      "enum": [
        "fridge",
        "dishwasher",
        "microwave"
      ]
    },
    "Locator": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "row": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "page"
          ]
        },
        {
          "required": [
            "row"
          ]
        },
        {
          "required": [
            "section"
          ]
        }
      ]
    },
    "Product": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "product_group": {
          "$ref": "#/$defs/ProductGroup"
        },
        "document_version": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "$ref": "#/$defs/SourceKind"
        }
      },
      "required": [
        "model_id",
        "name",
        "product_group",
        "document_version",
        "source_kind"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "document_version": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "source_type": {
          "enum": [
            "review",
            "manual"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "feature_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "model_id",
        "document_version",
        "source_kind",
        "source_type",
        "source_id",
        "locator",
        "text",
        "feature_ids"
      ],
      "additionalProperties": false
    },
    "Review": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "document_version": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        }
      },
      "required": [
        "id",
        "model_id",
        "text",
        "source_kind",
        "document_version",
        "source_id",
        "locator",
        "evidence_id"
      ],
      "additionalProperties": false
    },
    "Feature": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "document_version": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "model_id",
        "document_version",
        "name",
        "description",
        "conditions",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "PlanningRequest": {
      "type": "object",
      "properties": {
        "product_group": {
          "$ref": "#/$defs/ProductGroup"
        },
        "target_customer": {
          "type": "string",
          "minLength": 1
        },
        "use_situation": {
          "type": "string",
          "minLength": 1
        },
        "improvement_task": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "model_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "product_group",
        "target_customer",
        "use_situation",
        "improvement_task",
        "exclusions",
        "model_ids",
        "dataset_version"
      ],
      "additionalProperties": false
    },
    "Project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "request": {
          "$ref": "#/$defs/PlanningRequest"
        },
        "status": {
          "enum": [
            "draft",
            "active",
            "archived"
          ]
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "request",
        "status",
        "dataset_version"
      ],
      "additionalProperties": false
    },
    "Need": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "situation": {
          "type": "string",
          "minLength": 1
        },
        "pain": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "model_id",
        "situation",
        "pain",
        "evidence_ids",
        "uncertainties"
      ],
      "additionalProperties": false
    },
    "Gap": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "need_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "feature_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "support_status": {
          "enum": [
            "supported",
            "unsupported",
            "insufficient_evidence"
          ]
        },
        "remaining_pain": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "need_id",
        "model_id",
        "feature_ids",
        "support_status",
        "remaining_pain",
        "evidence_ids",
        "questions"
      ],
      "additionalProperties": false
    },
    "Concept": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "product",
            "feature",
            "service"
          ]
        },
        "gap_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "differentiation": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "proposed",
            "needs_review",
            "accepted",
            "rejected"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "gap_ids",
        "evidence_ids",
        "differentiation",
        "requirements",
        "assumptions",
        "status"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "INVALID_ARGUMENT",
            "INVALID_MODEL_ID",
            "INVALID_EVIDENCE_ID",
            "INVALID_DOCUMENT_VERSION",
            "NOT_IMPLEMENTED",
            "VALIDATION_FAILED",
            "INSUFFICIENT_EVIDENCE",
            "MODEL_UNAVAILABLE"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "additionalProperties": false
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "ok",
        "error"
      ],
      "additionalProperties": false
    },
    "Run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1
        },
        "contract_version": {
          "const": "0.1.0"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "completed",
            "held",
            "failed",
            "not_implemented"
          ]
        },
        "stage": {
          "enum": [
            "plan",
            "retrieve",
            "needs",
            "compare",
            "concepts",
            "review",
            "finished"
          ]
        },
        "revision_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "max_revisions": {
          "const": 2
        },
        "concepts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Concept"
          },
          "maxItems": 3
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "tool": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "stage",
              "summary",
              "tool",
              "evidence_ids"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "project_id",
        "dataset_version",
        "contract_version",
        "status",
        "stage",
        "revision_count",
        "max_revisions",
        "concepts",
        "unresolved",
        "evidence_ids",
        "events"
      ],
      "additionalProperties": false
    },
    "Manifest": {
      "type": "object",
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "const": "synthetic"
        },
        "model_count": {
          "type": "integer",
          "minimum": 1
        },
        "review_count": {
          "type": "integer",
          "minimum": 1
        },
        "analysis_implemented": {
          "const": false
        }
      },
      "required": [
        "dataset_id",
        "version",
        "description",
        "source_kind",
        "model_count",
        "review_count",
        "analysis_implemented"
      ],
      "additionalProperties": false
    },
    "DemoDataset": {
      "type": "object",
      "properties": {
        "manifest": {
          "$ref": "#/$defs/Manifest"
        },
        "products": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Product"
          }
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Review"
          }
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Feature"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        }
      },
      "required": [
        "manifest",
        "products",
        "reviews",
        "features",
        "evidence"
      ],
      "additionalProperties": false
    },
    "ProductsResponse": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "data": {
          "type": "object",
          "properties": {
            "products": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Product"
              }
            },
            "contract_version": {
              "const": "0.1.0"
            }
          },
          "required": [
            "products",
            "contract_version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "data"
      ],
      "additionalProperties": false
    },
    "EvidenceResponse": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "data": {
          "type": "object",
          "properties": {
            "evidence": {
              "$ref": "#/$defs/Evidence"
            },
            "contract_version": {
              "const": "0.1.0"
            }
          },
          "required": [
            "evidence",
            "contract_version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "data"
      ],
      "additionalProperties": false
    },
    "EvidenceSearchResponse": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "data": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1
            },
            "model_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "document_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Evidence"
              }
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "contract_version": {
              "const": "0.1.0"
            },
            "search_method": {
              "const": "literal_token_count"
            }
          },
          "required": [
            "query",
            "model_id",
            "document_version",
            "items",
            "total",
            "contract_version",
            "search_method"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "data"
      ],
      "additionalProperties": false
    },
    "BootstrapResponse": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "data": {
          "type": "object",
          "properties": {
            "manifest": {
              "$ref": "#/$defs/Manifest"
            },
            "products": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Product"
              }
            },
            "reviews": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Review"
              }
            },
            "features": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Feature"
              }
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Evidence"
              }
            },
            "contract_version": {
              "const": "0.1.0"
            }
          },
          "required": [
            "manifest",
            "products",
            "reviews",
            "features",
            "evidence",
            "contract_version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "data"
      ],
      "additionalProperties": false
    }
  }
}
