        "total_reviews": { "type": "integer", "minimum": 0 },
        "topics": { "type": "array", "items": { "$ref": "#/$defs/ReviewTrendTopic" }, "maxItems": 50 }
      },
      "required": ["bucket_id", "period_start", "period_end_exclusive", "label", "partial_period", "total_reviews", "topics"],
      "additionalProperties": false
    },
    "ReviewTrendAggregate": {
      "type": "object",
      "description": "Deterministic snapshot shared by private web and MCP. Project, canonical filters, frozen hashes and algorithm/taxonomy/dedup versions determine aggregate_id; client and time do not. Binding, counts, ratios and immutable-ID verification require semantic checks.",
      "properties": {
        "aggregate_id": { "$ref": "#/$defs/ReviewTrendAggregateId" },
        "project_id": { "$ref": "#/$defs/ReviewTrendIdentifier" },
