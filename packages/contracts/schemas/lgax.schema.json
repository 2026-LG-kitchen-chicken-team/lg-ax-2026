        "filters": { "$ref": "#/$defs/ReviewTrendRequest" },
        "timezone": { "const": "Asia/Seoul" },
        "aggregation_version": { "$ref": "#/$defs/ReviewTrendVersion" },
        "classification": { "$ref": "#/$defs/ReviewTrendClassification" },
        "topic_taxonomy_version": { "$ref": "#/$defs/ReviewTrendVersion" },
        "dedup_policy_version": { "$ref": "#/$defs/ReviewTrendVersion" },
        "counts": { "$ref": "#/$defs/ReviewTrendCounts" },
        "buckets": { "type": "array", "items": { "$ref": "#/$defs/ReviewTrendBucket" }, "maxItems": 120 },
        "warnings": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 800 }, "uniqueItems": true },
        "notes": { "type": "string", "maxLength": 800 }
      },
      "required": ["aggregate_id", "project_id", "dataset_version", "dataset_sha256", "annotation_version", "annotation_sha256", "trend_contract_version", "filters", "timezone", "aggregation_version", "classification", "topic_taxonomy_version", "dedup_policy_version", "counts", "buckets", "warnings"],
      "additionalProperties": false
    },
