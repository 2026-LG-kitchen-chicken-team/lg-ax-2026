# Build from reviewed source, then pin resulting immutable sha256 image ID in
# each private Worker config. Mutable tags are build inputs, never runtime IDs.
FROM node:22-bookworm-slim AS node
FROM python:3.11-slim-bookworm
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates tini \
 && rm -rf /var/lib/apt/lists/* \
 && python -m pip install --no-cache-dir uv==0.12.2 \
 && npm install --global @openai/codex@0.155.0 @anthropic-ai/claude-code@2.1.289 \
 && npm cache clean --force
WORKDIR /build
COPY pyproject.toml uv.lock /build/
ENV UV_PROJECT_ENVIRONMENT=/opt/lgax-venv UV_CACHE_DIR=/opt/uv-cache
RUN uv sync --locked --no-install-project \
 && chmod -R a+rX /opt/lgax-venv /opt/uv-cache
COPY apps/web/package.json apps/web/package-lock.json /build/web/
RUN cd /build/web \
 && npm ci --ignore-scripts --cache /opt/npm-cache \
 && chmod -R a+rX /opt/npm-cache \
 && rm -rf /build/web/node_modules \
 && mkdir -p /opt/npm-cache-seed \
 && cp -a /opt/npm-cache/. /opt/npm-cache-seed/ \
 && printf '#!/bin/sh\nset -eu\nmkdir -p "$HOME/npm-cache"\ncp -a /opt/npm-cache-seed/. "$HOME/npm-cache/"\nexec "$@"\n' > /usr/local/bin/lgax-exec \
 && chmod 0755 /usr/local/bin/lgax-exec \
 && rm -rf /build \
 && groupadd --gid 1000 executor \
 && useradd --uid 1000 --gid 1000 --create-home executor
ENV HOME=/home/executor \
    PATH=/opt/lgax-venv/bin:/usr/local/bin:/usr/bin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_OFFLINE=1
USER 1000:1000
WORKDIR /workspace
