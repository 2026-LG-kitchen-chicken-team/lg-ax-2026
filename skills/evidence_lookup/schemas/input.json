{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lgax:skill:evidence_lookup:input:1",
  "type": "object",
  "properties": {
    "model_id": {
      "$ref": "#/$defs/ID"
    },
    "document_version": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  },
  "required": [
    "model_id",
    "document_version",
    "query"
  ],
  "additionalProperties": false,
  "$defs": {
    "ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    }
  }
}
