{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lgax:skill:product_compare:output:1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "data": {
          "type": "object",
          "properties": {
            "model_id": {
              "$ref": "#/$defs/ID"
            },
            "document_version": {
              "type": "string",
              "minLength": 1
            },
            "skill_id": {
              "const": "product_compare"
            },
            "contract_version": {
              "const": "0.1.0"
            },
            "execution_kind": {
              "enum": [
                "deterministic",
                "live_model",
                "fixture"
              ]
            },
            "backend_id": {
              "type": "string",
              "minLength": 1
            },
            "source_kind": {
              "$ref": "#/$defs/SourceKind"
            },
            "result": {
              "type": "object",
              "properties": {
                "gaps": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Gap"
                  },
                  "uniqueItems": true
                },
                "unresolved": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "gaps",
                "unresolved"
              ],
              "additionalProperties": false
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Evidence"
              }
            }
          },
          "required": [
            "model_id",
            "document_version",
            "skill_id",
            "contract_version",
            "execution_kind",
            "backend_id",
            "source_kind",
            "result",
            "sources"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "ok",
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "Gap": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "need_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "feature_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "support_status": {
          "enum": [
            "supported",
            "unsupported",
            "insufficient_evidence"
          ]
        },
        "remaining_pain": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "need_id",
        "model_id",
        "feature_ids",
        "support_status",
        "remaining_pain",
        "evidence_ids",
        "questions"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "document_version": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "source_type": {
          "enum": [
            "review",
            "manual"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "feature_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "model_id",
        "document_version",
        "source_kind",
        "source_type",
        "source_id",
        "locator",
        "text",
        "feature_ids"
      ],
      "additionalProperties": false
    },
    "SourceKind": {
      "enum": [
        "synthetic",
        "public",
        "licensed",
        "private"
      ]
    },
    "Locator": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "row": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "page"
          ]
        },
        {
          "required": [
            "row"
          ]
        },
        {
          "required": [
            "section"
          ]
        }
      ]
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "INVALID_ARGUMENT",
            "INVALID_MODEL_ID",
            "INVALID_EVIDENCE_ID",
            "INVALID_DOCUMENT_VERSION",
            "NOT_IMPLEMENTED",
            "VALIDATION_FAILED",
            "INSUFFICIENT_EVIDENCE",
            "MODEL_UNAVAILABLE",
            "UNAUTHORIZED",
            "FORBIDDEN",
            "NOT_FOUND",
            "DATASET_MISMATCH",
            "CONNECTION_FAILED",
            "CONTRACT_MISMATCH"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "additionalProperties": false
    }
  }
}
