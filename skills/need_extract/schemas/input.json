{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lgax:skill:need_extract:input:1",
  "type": "object",
  "properties": {
    "model_id": {
      "$ref": "#/$defs/ID"
    },
    "document_version": {
      "type": "string",
      "minLength": 1
    },
    "review_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "required": [
    "model_id",
    "document_version",
    "review_evidence_ids"
  ],
  "additionalProperties": false,
  "$defs": {
    "ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    }
  }
}
