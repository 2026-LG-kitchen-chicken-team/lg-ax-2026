    "page": 41,
    "printed_page": 41,
    "section_start": "식초를 사용하여 청소하기",
    "start_char": 989,
    "end_char": 1049,
    "native_page_text_sha256": "56a0a6da3ae98e06c29a2fc8b196b280aa3fe1cb0e415f32319e646e80f18851",
