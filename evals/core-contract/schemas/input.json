{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lgax:core:judgement:input:1",
  "type": "object",
  "properties": {
    "request": {
      "$ref": "#/$defs/PlanningRequest"
    },
    "product": {
      "$ref": "#/$defs/Product"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Evidence"
      }
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Feature"
      }
    },
    "revision_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "max_concepts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "changed_evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ID"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "request",
    "product",
    "sources",
    "features",
    "revision_count",
    "max_concepts",
    "changed_evidence_ids"
  ],
  "additionalProperties": false,
  "$defs": {
    "PlanningRequest": {
      "type": "object",
      "properties": {
        "product_group": {
          "$ref": "#/$defs/ProductGroup"
        },
        "target_customer": {
          "type": "string",
          "minLength": 1
        },
        "use_situation": {
          "type": "string",
          "minLength": 1
        },
        "improvement_task": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "model_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "product_group",
        "target_customer",
        "use_situation",
        "improvement_task",
        "exclusions",
        "model_ids",
        "dataset_version"
      ],
      "additionalProperties": false
    },
    "ProductGroup": {
      "enum": [
        "fridge",
        "dishwasher",
        "microwave"
      ]
    },
    "Product": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "product_group": {
          "$ref": "#/$defs/ProductGroup"
        },
        "document_version": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "$ref": "#/$defs/SourceKind"
        }
      },
      "required": [
        "model_id",
        "name",
        "product_group",
        "document_version",
        "source_kind"
      ],
      "additionalProperties": false
    },
    "SourceKind": {
      "enum": [
        "synthetic",
        "public",
        "licensed",
        "private"
      ]
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "document_version": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "source_type": {
          "enum": [
            "review",
            "manual"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "feature_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "model_id",
        "document_version",
        "source_kind",
        "source_type",
        "source_id",
        "locator",
        "text",
        "feature_ids"
      ],
      "additionalProperties": false
    },
    "Locator": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "row": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "page"
          ]
        },
        {
          "required": [
            "row"
          ]
        },
        {
          "required": [
            "section"
          ]
        }
      ]
    },
    "Feature": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "document_version": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "model_id",
        "document_version",
        "name",
        "description",
        "conditions",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    }
  }
}
